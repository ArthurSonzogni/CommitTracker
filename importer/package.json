{
  "name": "chromium-commit-tracker",
  "type": "module",
  "version": "1.0.0",
  "description": "data visualization for chromium commits",
  "main": "index.mjs",
  "scripts": {
    "fetch_data": "node fetch_data.mjs",
    "derive_data": "node derive_data.mjs && node badges.mjs",
    "treemap": "node treemap.mjs",
    "graph": "node graph.mjs",
    "fixmailmap": "node fixmailmap.mjs",
    "commit_rates": "node commit_rates.mjs",
    "fuzztest": "node fuzz-test.mjs",
    "cve": "node cve.mjs",
    "accretion": "node --max-old-space-size=8192 accretion.mjs chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurSonzogni/CommitTracker.git"
  },
  "keywords": [
    "chrome",
    "chromium",
    "commit",
    "tracker",
    "visualization"
  ],
  "author": "Arthur Sonzogni",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ArthurSonzogni/CommitTracker/issues"
  },
  "homepage": "https://github.com/ArthurSonzogni/CommitTracker#readme",
  "dependencies": {
    "@alt-jero/status-line": "^1.0.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "cli-progress": "^3.12.0",
    "json5": "^2.2.3",
    "octokit": "^5.0.5",
    "puppeteer": "^25.16.0",
    "yaml": "^2.8.3"
  }
}
